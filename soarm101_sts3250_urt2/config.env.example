# LeRobot 源码目录。此路径相对于本文件所在目录。
LEROBOT_DIR=../lerobot

# 已激活 Conda 环境中的 Python。默认填写 python 即可。
PYTHON_CMD=python

# URT-2 在 Linux 中常为 /dev/ttyUSB0，也可能是 /dev/ttyACM0。
FOLLOWER_PORT=/dev/ttyUSB0
FOLLOWER_ID=soarm101_sts3250

# 若使用原版 SO-101 leader，填写它自己的 URT-2 端口和 ID。
LEADER_PORT=/dev/ttyUSB1
LEADER_ID=soarm101_leader

# 第一次遥操作保持较小值；单位由当前 LeRobot SO follower 配置决定，默认是度。
MAX_RELATIVE_TARGET=5

# 可选相机。留空时遥操作不采集图像。
CAMERAS={}
